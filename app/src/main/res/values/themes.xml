<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      MainActivity herda de AppCompatActivity (troca de idioma via AppCompatDelegate),
      por isso o tema XML herda de Theme.AppCompat. As cores das telas vêm do tema Compose (ui/theme).
    -->
    <style name="Theme.HopeMind" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="colorAccent">@color/brand_tint</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
