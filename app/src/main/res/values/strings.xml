    <!-- About -->
    <string name="about_what_title">What it is</string>
    <string name="about_what_text">HopeMind connects patients to psychologists with the most compatible therapy style, experience and schedule, based on questionnaires from both sides.</string>
    <string name="about_how_title">How matching works</string>
    <string name="about_how_text">First, incompatible professionals are filtered out (format, city, age group, schedule). Then 7 weighted components defined in the requirements document produce an estimate, always explained with the reasons.</string>
    <string name="about_safety_title">Care with risk answers</string>
    <string name="about_safety_text">Self-harm answers never affect the score: they show support services (CVV 188, SAMU 192) and open an alert for the team.</string>
    <string name="about_tech_title">Technology</string>
    <string name="about_tech_text">Kotlin · Jetpack Compose · Material 3 · Navigation · Retrofit. Uses the same API and database as the web version.</string>
    <string name="version_format">Version %1$s</string>
    <!-- Home, Matches e CEP -->
    <string name="tab_matches">Matches</string>
    <string name="home_hero_title">Caring for your mind starts with the right match.</string>
    <string name="home_hero_lede">HopeMind connects people with psychologists they truly fit with — what they need to work on, how therapy is led, schedule and distance.</string>
    <string name="home_cta_matches">See my matches</string>
    <string name="home_cta_find">Find my psychologist</string>
    <string name="home_cta_agenda">See my agenda</string>
    <string name="home_about_eyebrow">Who we are</string>
    <string name="home_about_title">A mental health platform built for the first step.</string>
    <string name="home_about_p1">Looking for therapy often starts with a huge list of names and no clue who will understand you. Many people give up there, or switch professionals several times until they feel at ease.</string>
    <string name="home_about_p2">HopeMind was born at SafeMindLive to shorten that path. The relationship between patient and psychologist — the therapeutic alliance — is one of the factors most associated with good outcomes in psychotherapy. That is why we look beyond specialty, at how the two of you work together.</string>
    <string name="home_how_eyebrow">How it works</string>
    <string name="home_how_title">Three steps to your first session</string>
    <string name="home_step1_title">Tell us about you</string>
    <string name="home_step1_text">A 5-minute questionnaire: what brings you here, how you like to talk, your routine and whether you prefer online or in person.</string>
    <string name="home_step2_title">Get your matches</string>
    <string name="home_step2_text">We compare your answers with the psychologists’ and show the 10 most compatible — with the reasons for each and the distance to the office.</string>
    <string name="home_step3_title">Book your first session</string>
    <string name="home_step3_text">Pick a time that works for both of you. If it does not click, just come back and try another match.</string>
    <string name="home_factors_eyebrow">What we consider</string>
    <string name="home_factors_title">Compatibility you can explain</string>
    <string name="home_factors_text">First we remove professionals who cannot see you — format, schedule, age group or distance. Then each factor becomes a 0–100% score weighted as below.</string>
    <string name="factor_demanda">Declared experience in what you want to work on.</string>
    <string name="factor_estilo">More structured or freer, more directive or more exploratory.</string>
    <string name="factor_localizacao">Online, in person, and how close the office is to your CEP.</string>
    <string name="factor_experiencia">Depth of practice in each topic.</string>
    <string name="factor_relacao">The warmth, frankness and pace you expect.</string>
    <string name="factor_disponibilidade">Days and periods in common.</string>
    <string name="factor_preferencias">Only when you state one.</string>
    <string name="home_principles_eyebrow">Our principles</string>
    <string name="home_principles_title">Technology in service of care</string>
    <string name="principle_transparent_title">Transparent</string>
    <string name="principle_transparent_text">Every recommendation comes with the “why”. No black box: you see the weight of each factor.</string>
    <string name="principle_safe_title">Safe by default</string>
    <string name="principle_safe_text">Risk answers never affect the score. They trigger immediate support and only route you to professionals prepared to help.</string>
    <string name="principle_private_title">Private</string>
    <string name="principle_private_text">Your address is only used to calculate distances. Patients see the neighborhood, never anyone’s street.</string>
    <string name="principle_near_title">Close to you</string>
    <string name="principle_near_text">We start in Recife: real neighborhoods, real CEPs and distances for those who prefer in-person care.</string>
    <string name="home_approaches_eyebrow">Approaches</string>
    <string name="home_approaches_title">There are many ways to do therapy</string>
    <string name="home_approaches_text">You don’t need to know yours — the questionnaire asks how you like to be treated and we translate that. But if you are curious:</string>
    <string name="approach_tcc_name">CBT</string>
    <string name="approach_tcc_text">Focuses on present thoughts and behaviors, with goals and practical exercises.</string>
    <string name="approach_psicanalise_name">Psychoanalysis</string>
    <string name="approach_psicanalise_text">Explores life history and what goes unsaid, at each person’s pace.</string>
    <string name="approach_humanista_name">Humanistic</string>
    <string name="approach_humanista_text">Starts from warm listening and your own capacity to grow.</string>
    <string name="approach_sistemica_name">Systemic</string>
    <string name="approach_sistemica_text">Looks at you within your relationships: family, couple, work.</string>
    <string name="approach_act_name">ACT and DBT</string>
    <string name="approach_act_text">Acceptance, mindfulness and skills to regulate intense emotions.</string>
    <string name="approach_emdr_name">EMDR</string>
    <string name="approach_emdr_text">A structured approach to process traumatic memories.</string>
    <string name="home_habits_eyebrow">Day to day</string>
    <string name="home_habits_title">Small habits count too</string>
    <string name="habit_sleep_title">Sleep</string>
    <string name="habit_sleep_text">Regular hours help mood and focus more than it seems.</string>
    <string name="habit_pause_title">Breaks</string>
    <string name="habit_pause_text">A few minutes away from screens during the day reduce overload.</string>
    <string name="habit_support_title">Support network</string>
    <string name="habit_support_text">Talking to someone you trust is self-care, not a burden.</string>
    <string name="home_help_title">Need help right now?</string>
    <string name="home_help_text">HopeMind is not an emergency service. If you are in intense distress or thinking about hurting yourself, talk to CVV now at 188 (24 hours, free and confidential) or call SAMU at 192.</string>
    <string name="call_cvv">Call CVV 188</string>
    <string name="call_samu">SAMU 192</string>
